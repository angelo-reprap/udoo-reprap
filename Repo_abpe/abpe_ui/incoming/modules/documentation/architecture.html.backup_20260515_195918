{% extends 'abpe_ui/base.html' %}
{% load static %}

{% block title %}{% endblock %}

{% block module_css %}
<link href="{% static 'abpe_ui/css/mod/mod-documentation.css' %}" rel="stylesheet">
{% endblock %}

{% block content %}
<div class="doc-container">
    <div class="stats-grid" style="margin-bottom: 2rem;">
        <div class="stat-card">
            <div class="stat-value">v3.0</div>
            <div class="stat-title" data-i18n="doc.version">Version</div>
        </div>
        <div class="stat-card">
            <div class="stat-value">Django</div>
            <div class="stat-title" data-i18n="doc.framework">Framework</div>
        </div>
        <div class="stat-card">
            <div class="stat-value">23k+</div>
            <div class="stat-title" data-i18n="doc.users">Benutzer</div>
        </div>
        <div class="stat-card">
            <div class="stat-value">16</div>
            <div class="stat-title" data-i18n="doc.chapters">Kapitel</div>
        </div>
    </div>

    <div class="doc-toc">
        <h5 data-i18n="doc.toc.title">Inhaltsverzeichnis</h5>
        <div class="toc-grid">
            <button class="toc-item" data-section="grundlagen" data-i18n="doc.section1">1. Grundlagen</button>
            <button class="toc-item" data-section="modulsystem" data-i18n="doc.section2">2. Modul-System</button>
            <button class="toc-item" data-section="i18n" data-i18n="doc.section3">3. Sprachsystem</button>
            <button class="toc-item" data-section="theme" data-i18n="doc.section4">4. Theme-System</button>
            <button class="toc-item" data-section="multiuser" data-i18n="doc.section5">5. Multi-User</button>
            <button class="toc-item" data-section="hilfe" data-i18n="doc.section6">6. Hilfe-System</button>
            <button class="toc-item" data-section="sidebar" data-i18n="doc.section7">7. Navigation</button>
            <button class="toc-item" data-section="api" data-i18n="doc.section8">8. API</button>
            <button class="toc-item" data-section="backup" data-i18n="doc.section9">9. Backup</button>
            <button class="toc-item" data-section="helper" data-i18n="doc.section10">10. Helper</button>
            <button class="toc-item" data-section="responsive" data-i18n="doc.section11">11. Responsive</button>
            <button class="toc-item" data-section="verzeichnisse" data-i18n="doc.section12">12. Verzeichnisse</button>
            <button class="toc-item" data-section="workflow" data-i18n="doc.section13">13. Workflow</button>
            <button class="toc-item" data-section="debugging" data-i18n="doc.section14">14. Debugging</button>
            <button class="toc-item" data-section="versionen" data-i18n="doc.section15">15. Versionen</button>
            <button class="toc-item" data-section="anhang" data-i18n="doc.section16">16. Anhänge</button>
        </div>
    </div>

    <!-- Nutzt bestehende toggle-section Klasse aus ui-components.css -->
    <div class="toggle-section" id="section-grundlagen">
        <div class="section-header" onclick="toggleSection(this)">
            <i class="bi bi-info-circle"></i> <span data-i18n="doc.section1">1. Grundlagen & Überblick</span>
            <i class="bi bi-chevron-down"></i>
        </div>
        <div class="section-content" data-i18n="doc.content.grundlagen"></div>
    </div>

    <div class="toggle-section" id="section-modulsystem">
        <div class="section-header" onclick="toggleSection(this)">
            <i class="bi bi-puzzle"></i> <span data-i18n="doc.section2">2. Modul-System</span>
            <i class="bi bi-chevron-down"></i>
        </div>
        <div class="section-content" data-i18n="doc.content.modulsystem"></div>
    </div>

    <div class="toggle-section" id="section-i18n">
        <div class="section-header" onclick="toggleSection(this)">
            <i class="bi bi-globe2"></i> <span data-i18n="doc.section3">3. Sprach- & Übersetzungssystem</span>
            <i class="bi bi-chevron-down"></i>
        </div>
        <div class="section-content" data-i18n="doc.content.i18n"></div>
    </div>

    <div class="toggle-section" id="section-theme">
        <div class="section-header" onclick="toggleSection(this)">
            <i class="bi bi-palette"></i> <span data-i18n="doc.section4">4. Theme & Design-System</span>
            <i class="bi bi-chevron-down"></i>
        </div>
        <div class="section-content" data-i18n="doc.content.theme"></div>
    </div>

    <div class="toggle-section" id="section-multiuser">
        <div class="section-header" onclick="toggleSection(this)">
            <i class="bi bi-people"></i> <span data-i18n="doc.section5">5. Multi-User & Berechtigungen</span>
            <i class="bi bi-chevron-down"></i>
        </div>
        <div class="section-content" data-i18n="doc.content.multiuser"></div>
    </div>

    <div class="toggle-section" id="section-hilfe">
        <div class="section-header" onclick="toggleSection(this)">
            <i class="bi bi-question-circle"></i> <span data-i18n="doc.section6">6. Hilfe-System</span>
            <i class="bi bi-chevron-down"></i>
        </div>
        <div class="section-content" data-i18n="doc.content.hilfe"></div>
    </div>

    <div class="toggle-section" id="section-sidebar">
        <div class="section-header" onclick="toggleSection(this)">
            <i class="bi bi-layout-sidebar"></i> <span data-i18n="doc.section7">7. Sidebar & Navigation</span>
            <i class="bi bi-chevron-down"></i>
        </div>
        <div class="section-content" data-i18n="doc.content.sidebar"></div>
    </div>

    <div class="toggle-section" id="section-api">
        <div class="section-header" onclick="toggleSection(this)">
            <i class="bi bi-code-square"></i> <span data-i18n="doc.section8">8. API & Externe Integration</span>
            <i class="bi bi-chevron-down"></i>
        </div>
        <div class="section-content" data-i18n="doc.content.api"></div>
    </div>

    <div class="toggle-section" id="section-backup">
        <div class="section-header" onclick="toggleSection(this)">
            <i class="bi bi-archive"></i> <span data-i18n="doc.section9">9. Backup & Archiv-System</span>
            <i class="bi bi-chevron-down"></i>
        </div>
        <div class="section-content" data-i18n="doc.content.backup"></div>
    </div>

    <div class="toggle-section" id="section-helper">
        <div class="section-header" onclick="toggleSection(this)">
            <i class="bi bi-tools"></i> <span data-i18n="doc.section10">10. Helper & Utility Scripts</span>
            <i class="bi bi-chevron-down"></i>
        </div>
        <div class="section-content" data-i18n="doc.content.helper"></div>
    </div>

    <div class="toggle-section" id="section-responsive">
        <div class="section-header" onclick="toggleSection(this)">
            <i class="bi bi-phone"></i> <span data-i18n="doc.section11">11. Responsive Design</span>
            <i class="bi bi-chevron-down"></i>
        </div>
        <div class="section-content" data-i18n="doc.content.responsive"></div>
    </div>

    <div class="toggle-section" id="section-verzeichnisse">
        <div class="section-header" onclick="toggleSection(this)">
            <i class="bi bi-folder2"></i> <span data-i18n="doc.section12">12. Verzeichnisstruktur</span>
            <i class="bi bi-chevron-down"></i>
        </div>
        <div class="section-content" data-i18n="doc.content.verzeichnisse"></div>
    </div>

    <div class="toggle-section" id="section-workflow">
        <div class="section-header" onclick="toggleSection(this)">
            <i class="bi bi-diagram-3"></i> <span data-i18n="doc.section13">13. Entwicklungsworkflow</span>
            <i class="bi bi-chevron-down"></i>
        </div>
        <div class="section-content" data-i18n="doc.content.workflow"></div>
    </div>

    <div class="toggle-section" id="section-debugging">
        <div class="section-header" onclick="toggleSection(this)">
            <i class="bi bi-bug"></i> <span data-i18n="doc.section14">14. Fehlersuche & Debugging</span>
            <i class="bi bi-chevron-down"></i>
        </div>
        <div class="section-content" data-i18n="doc.content.debugging"></div>
    </div>

    <div class="toggle-section" id="section-versionen">
        <div class="section-header" onclick="toggleSection(this)">
            <i class="bi bi-tag"></i> <span data-i18n="doc.section15">15. Versionierung & Changelog</span>
            <i class="bi bi-chevron-down"></i>
        </div>
        <div class="section-content" data-i18n="doc.content.versionen"></div>
    </div>

    <div class="toggle-section" id="section-anhang">
        <div class="section-header" onclick="toggleSection(this)">
            <i class="bi bi-paperclip"></i> <span data-i18n="doc.section16">16. Anhänge</span>
            <i class="bi bi-chevron-down"></i>
        </div>
        <div class="section-content" data-i18n="doc.content.anhang"></div>
    </div>
</div>
{% endblock %}

{% block module_js %}
<script src="{% static 'abpe_ui/js/mod/mod-documentation.js' %}"></script>
{% endblock %}

{% block extra_js %}
<script>
    document.addEventListener('DOMContentLoaded', function() {
        if (typeof loadLanguage === 'function') {
            loadLanguage('{{ current_lang|default:"de" }}', 'documentation');
        }
    });
</script>
{% endblock %}
