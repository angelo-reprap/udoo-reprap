    _meetmeToggleTimeField() {
        const unit = this.$('pbx-mr-unit').value;
        const wrap = this.$('pbx-mr-time-wrap');
        if (wrap) wrap.style.display = (unit === 'DAYS') ? '' : 'none';
    },

    _meetmeToggleCopyField() {
        const mode = this.$('pbx-mr-mode').value;
        const wrap = this.$('pbx-mr-copy-wrap');
        if (wrap) wrap.style.display = (mode === 'AUTO') ? '' : 'none';
    },

    async meetmeCreateReminder(meetingId) {
        const value = parseInt(this.$('pbx-mr-value').value, 10) || 1;
        const unit = this.$('pbx-mr-unit').value;
        const mode = this.$('pbx-mr-mode').value;
        const timeInp = this.$('pbx-mr-time');
        const copyInp = this.$('pbx-mr-copy');
        const body = { offset_value: value, offset_unit: unit, mode };
        if (unit === 'DAYS' && timeInp && timeInp.value) {
            body.time_of_day = timeInp.value + ':00';
        }
        if (mode === 'AUTO') {
            body.send_copy_to_owner = !!(copyInp && copyInp.checked);
        }
        try {
            await this.post(`/meetme/api/meetings/${meetingId}/reminder-rules/create/`, body);
            this.meetmeCloseModal();
            this.toast(this.t('pbx_meetme_reminder_saved', 'Erinnerung gespeichert'));
            this.meetmeSelectMeeting(meetingId);
        } catch (e) {
            this.toast(this.t('pbx_meetme_reminder_err', 'Erinnerung konnte nicht gespeichert werden'));
        }
    },

    _meetmeUnitLabel(unit) {
        const map = { DAYS: this.t('pbx_meetme_unit_days', 'Tage'), HOURS: this.t('pbx_meetme_unit_hours', 'Stunden'), MINUTES: this.t('pbx_meetme_unit_minutes', 'Minuten') };
        return map[unit] || unit;
    },
    _meetmeFmtDate(iso) {
        const d = new Date(iso);
        return d.toLocaleDateString('de-DE', { day: '2-digit', month: '2-digit' }) + ' ' + d.toLocaleTimeString('de-DE', { hour: '2-digit', minute: '2-digit' });
    },
    _meetmeFmtDateTime(iso) {
        const d = new Date(iso);
        return d.toLocaleDateString('de-DE') + ', ' + d.toLocaleTimeString('de-DE', { hour: '2-digit', minute: '2-digit' });
    },
    _meetmeEsc(s) {
        const div = document.createElement('div');
        div.textContent = s || '';
        return div.innerHTML;
    },
});


