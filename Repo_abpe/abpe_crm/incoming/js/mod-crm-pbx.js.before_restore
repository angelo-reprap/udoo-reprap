Object.assign(PBX, {
    async del(url) {
        const r = await fetch(url, {
            method: 'DELETE',
            headers: { 'X-CSRFToken': this.csrf(), 'X-Requested-With': 'XMLHttpRequest' },
        });
        if (r.status === 204) return { success: true };
        try { return await r.json(); }
        catch (e) { return { success: r.ok }; }
    },
});

