Object.assign(PBX, {
    _mmGuestCache: {},

    async meetmeShowGuestPhone(guestId) {
        const g = this._mmFindGuestObj(guestId);
        let phones = [];

        if (g && g.contact_crm_id) {
            try {
                const detail = await this.get(`/crm/api/berater/${g.contact_crm_id}/`);
                if (detail && Array.isArray(detail.phones)) {
                    phones = detail.phones.map(p => ({ raw: p.raw, label: p.label || p.field_name || '', primary: p.is_primary }));
                }
            } catch (e) { /* Fallback unten */ }
        }
        if (!phones.length && g && g.phone) {
            phones = [{ raw: g.phone, label: '', primary: true }];
        }
        phones.sort((a, b) => (b.primary ? 1 : 0) - (a.primary ? 1 : 0));

        const overlay = document.createElement('div');
        overlay.className = 'pbx-meetme-modal-overlay';
        overlay.id = 'pbx-meetme-modal-overlay';
        overlay.innerHTML = `
            <div class="pbx-meetme-modal" style="width:340px">
                <h4>${this.t('pbx_mm_call', 'Anrufen')} — ${this._meetmeEsc(g ? g.name : '')}</h4>
                ${phones.length ? `
                    <div style="display:flex;flex-direction:column;gap:6px;margin-bottom:12px">
                        ${phones.map(p => `
                            <div style="display:flex;justify-content:space-between;align-items:center;padding:6px 8px;background:var(--abcona-surface-1,#f7f7f7);border-radius:6px">
                                <span style="font-size:13px;font-weight:600">${this._meetmeEsc(p.raw)}${p.label ? ` <span style="font-weight:400;color:#999;font-size:11px">(${this._meetmeEsc(p.label)})</span>` : ''}${p.primary ? ' <span style="color:#999;font-size:11px">★</span>' : ''}</span>
                                <button class="pbx-act pbx-act-green" style="padding:4px 10px" onclick="PBX.meetmeDialGuest('${p.raw}')"><i class="bi bi-telephone-outbound"></i></button>
                            </div>
                        `).join('')}
                    </div>
                    <div class="pbx-meetme-modal-actions">
                        <button class="pbx-act pbx-act-gray" onclick="PBX.meetmeCloseModal()">${this.t('pbx_cancel', 'Schließen')}</button>
                    </div>
                ` : `
                    <p class="pbx-hint">${this.t('pbx_mm_no_phone', 'Keine Telefonnummer hinterlegt')}</p>
                    <div class="pbx-meetme-modal-actions">
                        <button class="pbx-act pbx-act-gray" onclick="PBX.meetmeCloseModal()">${this.t('pbx_cancel', 'Schließen')}</button>
                    </div>
                `}
            </div>
        `;
        document.body.appendChild(overlay);
    },

    _mmFindGuestObj(guestId) {
        const m = (this._meetmeState.meetings || []).find(x => x.id === this._meetmeState.selectedId);
        if (!m || !m.guests) return null;
        return m.guests.find(x => x.id === guestId) || null;
    },

    async meetmeDialGuest(phone) {
        this.meetmeCloseModal();
        const desk = (this.$('pbx-dial-ext') || {}).value || this.ext;
        try {
            const res = await this.post(this.api.dial, { desk, target: phone });
            this.toast(res.success ? this.t('pbx_dialing', 'Wird angerufen') : (res.error || this.t('pbx_dial_err', 'Anruf fehlgeschlagen')));
        } catch (e) {
            this.toast(this.t('pbx_dial_err', 'Anruf fehlgeschlagen'));
        }
    },

    async meetmeShowGuestCompose(guestId) {
        const m = (this._meetmeState.meetings || []).find(x => x.id === this._meetmeState.selectedId);
        const g = m && m.guests ? m.guests.find(x => x.id === guestId) : null;
        if (!g) return;

        let tplData = null;
        try { tplData = await this.get(this.api.emailTemplates); }
        catch (e) { /* optional */ }
        const templates = (tplData && tplData.templates) || [];

        const overlay = document.createElement('div');
        overlay.className = 'pbx-meetme-modal-overlay';
        overlay.id = 'pbx-meetme-modal-overlay';
        overlay.innerHTML = `
            <div class="pbx-meetme-modal pbx-sa-modal">
                <div style="display:flex;justify-content:space-between;align-items:center">
                    <h4 style="margin:0">${this.t('pbx_mm_compose', 'E-Mail an')} ${this._meetmeEsc(g.name)}</h4>
                    <button class="pbx-act pbx-act-gray" onclick="PBX.meetmeCloseModal()"><i class="bi bi-x-lg"></i></button>
                </div>
                <p class="pbx-sa-meta">${this._meetmeEsc(g.email || '')}</p>

                <label>${this.t('pbx_sa_template', 'Vorlage')}</label>
                <div style="display:flex;gap:6px">
                    <select id="pbx-mm-compose-tpl" style="flex:1">
                        <option value="">${this.t('pbx_sa_template_none', '– keine –')}</option>
                        ${templates.map(t => `<option value="${t.id}">${this._meetmeEsc(t.name)}</option>`).join('')}
                    </select>
                    <button class="pbx-act pbx-act-gray" onclick="PBX._mmComposeLoadTemplate()">${this.t('pbx_sa_load', 'Laden')}</button>
                </div>

                <div class="pbx-sa-mailbox">
                    <div class="pbx-sa-subject">
                        <input id="pbx-mm-compose-subject" type="text" placeholder="${this.t('pbx_sa_subject_ph', 'Betreff')}">
                    </div>
                    <div class="pbx-sa-body">
                        <textarea id="pbx-mm-compose-body" rows="7"></textarea>
                    </div>
                </div>

                <div class="pbx-meetme-modal-actions">
                    <button class="pbx-act pbx-act-gray" onclick="PBX.meetmeCloseModal()">${this.t('pbx_cancel', 'Abbrechen')}</button>
                    <button class="pbx-act pbx-act-green" onclick="PBX._mmComposeSend(${guestId})">${this.t('pbx_sa_send', 'Senden')}</button>
                </div>
            </div>
        `;
        document.body.appendChild(overlay);
    },

    async _mmComposeLoadTemplate() {
        const tplId = this.$('pbx-mm-compose-tpl').value;
        if (!tplId) return;
        try {
            const data = await this.get(this.api.emailTemplates + tplId + '/');
            const tpl = data && data.template;
            if (!tpl) return;
            this.$('pbx-mm-compose-subject').value = tpl.subject || '';
            this.$('pbx-mm-compose-body').value = tpl.text_body || tpl.html_body || '';
        } catch (e) {
            this.toast(this.t('pbx_sa_template_err', 'Vorlage konnte nicht geladen werden'));
        }
    },

    async _mmComposeSend(guestId) {
        const subject = this.$('pbx-mm-compose-subject').value.trim();
        const body = this.$('pbx-mm-compose-body').value.trim();
        if (!subject || !body) {
            this.toast(this.t('pbx_mm_compose_req', 'Betreff und Text erforderlich'));
            return;
        }
        try {
            await this.post(`/meetme/api/guests/${guestId}/send-adhoc/`, { subject, body });
            this.toast(this.t('pbx_mm_compose_sent', 'E-Mail gesendet'));
            this.meetmeCloseModal();
        } catch (e) {
            this.toast(this.t('pbx_mm_compose_err', 'Senden fehlgeschlagen'));
        }
    },
});

// ============================================================
// Termin verschieben
// ============================================================
Object.assign(PBX, {
    meetmeShowRescheduleModal(meetingId) {
        const m = (this._meetmeState.meetings || []).find(x => x.id === meetingId);
        if (!m) return;

        const current = new Date(m.start_at);
        const pad = n => String(n).padStart(2, '0');
        const localValue = `${current.getFullYear()}-${pad(current.getMonth()+1)}-${pad(current.getDate())}T${pad(current.getHours())}:${pad(current.getMinutes())}`;

        const overlay = document.createElement('div');
        overlay.className = 'pbx-meetme-modal-overlay';
        overlay.id = 'pbx-meetme-modal-overlay';
        overlay.innerHTML = `
            <div class="pbx-meetme-modal">
                <h4>${this.t('pbx_meetme_reschedule', 'Termin verschieben')}</h4>
                <p style="font-size:12px;color:#888;margin:0 0 10px">${this._meetmeEsc(m.title)}</p>
                <label>${this.t('pbx_meetme_new_start', 'Neues Datum/Zeit')}</label>
                <input id="pbx-mm-reschedule-start" type="datetime-local" value="${localValue}">
                <p class="pbx-hint" style="margin-top:10px">
                    ${this.t('pbx_meetme_reschedule_hint', 'Gäste, die bereits eine Erinnerung erhalten haben, bekommen automatisch einen Terminänderungs-Hinweis in die Sende-Warteschlange. Gäste ohne bisherige Benachrichtigung werden separat aufgelistet.')}
                </p>
                <div class="pbx-meetme-modal-actions">
                    <button class="pbx-act pbx-act-gray" onclick="PBX.meetmeCloseModal()">${this.t('pbx_cancel', 'Abbrechen')}</button>
                    <button class="pbx-act pbx-act-green" onclick="PBX.meetmeConfirmReschedule(${meetingId})">${this.t('pbx_meetme_reschedule_confirm', 'Verschieben')}</button>
                </div>
            </div>
        `;
        document.body.appendChild(overlay);
    },

    async meetmeConfirmReschedule(meetingId) {
        const inp = this.$('pbx-mm-reschedule-start');
        if (!inp || !inp.value) { this.toast(this.t('pbx_meetme_fields_req', 'Datum erforderlich')); return; }
        const newStartIso = new Date(inp.value).toISOString();

        try {
            const res = await this.post(`/meetme/api/meetings/${meetingId}/reschedule/`, { new_start_at: newStartIso });
            this.meetmeCloseModal();
            this._meetmeShowRescheduleResult(res, meetingId);
        } catch (e) {
            this.toast(this.t('pbx_meetme_reschedule_err', 'Verschieben fehlgeschlagen'));
        }
    },

    async _meetmeShowRescheduleResult(res, meetingId) {
        const notNotified = res.not_notified_guests || [];

        // Alle Telefonnummern pro Gast live nachladen (nicht nur die eine gespeicherte)
        const phoneLists = await Promise.all(notNotified.map(async g => {
            if (!g.contact_crm_id) return [g.phone].filter(Boolean).map(p => ({ raw: p, primary: true }));
            try {
                const detail = await this.get(`/crm/api/berater/${g.contact_crm_id}/`);
                if (detail && Array.isArray(detail.phones) && detail.phones.length) {
                    return detail.phones.map(p => ({ raw: p.raw, label: p.label || p.field_name || '', primary: p.is_primary }));
                }
            } catch (e) { /* Fallback unten */ }
            return [g.phone].filter(Boolean).map(p => ({ raw: p, primary: true }));
        }));

        const overlay = document.createElement('div');
        overlay.className = 'pbx-meetme-modal-overlay';
        overlay.id = 'pbx-meetme-modal-overlay';
        overlay.innerHTML = `
            <div class="pbx-meetme-modal">
                <h4><i class="bi bi-check-circle-fill" style="color:#0f5132"></i> ${this.t('pbx_meetme_reschedule_done', 'Termin verschoben')}</h4>
                <p style="font-size:13px;margin:10px 0">
                    ${res.change_notice_count > 0
                        ? `${res.change_notice_count} ${this.t('pbx_meetme_reschedule_notified', 'Gast/Gäste wurden automatisch für eine Terminänderungs-Mail in die Warteschlange gestellt.')}`
                        : this.t('pbx_meetme_reschedule_none_notified', 'Niemand hatte bereits eine Erinnerung erhalten - keine Terminänderungs-Mails nötig.')}
                </p>
                ${notNotified.length ? `
                    <div class="pbx-meetme-section">
                        <p style="font-size:12.5px;font-weight:600;margin:0 0 8px"><i class="bi bi-telephone-fill"></i> ${this.t('pbx_meetme_please_call', 'Bitte anrufen und informieren')}</p>
                        ${notNotified.map((g, i) => {
                            const phones = phoneLists[i];
                            phones.sort((a, b) => (b.primary ? 1 : 0) - (a.primary ? 1 : 0));
                            return `
                                <div style="margin-bottom:10px">
                                    <p style="font-size:12.5px;font-weight:600;margin:0 0 4px">${this._meetmeEsc(g.name)}</p>
                                    ${phones.length ? phones.map(p => `
                                        <div class="pbx-meetme-guestrow" style="margin-bottom:4px">
                                            <span style="font-size:12px">${this._meetmeEsc(p.raw)}${p.label ? ` <span style="color:#999;font-size:11px">(${this._meetmeEsc(p.label)})</span>` : ''}${p.primary ? ' <span style="color:#999;font-size:11px">★</span>' : ''}</span>
                                            <button class="pbx-act pbx-act-green" style="padding:3px 9px" onclick="PBX.meetmeDialGuest('${p.raw}')"><i class="bi bi-telephone-outbound"></i></button>
                                        </div>
                                    `).join('') : `<span class="pbx-hint">${this.t('pbx_mm_no_phone', 'keine Nummer hinterlegt')}</span>`}
                                </div>
                            `;
                        }).join('')}
                    </div>
                ` : ''}
                <div class="pbx-meetme-modal-actions">
                    ${res.change_notice_count > 0 ? `<button class="pbx-act pbx-act-blue" onclick="PBX.meetmeCloseModal(); PBX.meetmeOpenSendAssistant(${meetingId})">${this.t('pbx_meetme_open_sa', 'Einladungen/Erinnerungen verschicken')}</button>` : ''}
                    <button class="pbx-act pbx-act-gray" onclick="PBX.meetmeCloseModal(); PBX.meetmeSelectMeeting(${meetingId})">${this.t('pbx_close', 'Schließen')}</button>
                </div>
            </div>
        `;
        document.body.appendChild(overlay);
    },
});

// ============================================================
// Meeting bearbeiten / absagen
// ============================================================
Object.assign(PBX, {
    async meetmeShowEditModal(meetingId) {
        const m = (this._meetmeState.meetings || []).find(x => x.id === meetingId);
        if (!m) return;

        let rooms = [];
        try { const d = await this.get(this.api.meetmeRooms); rooms = d.rooms || []; } catch (e) {}

        const overlay = document.createElement('div');
        overlay.className = 'pbx-meetme-modal-overlay';
        overlay.id = 'pbx-meetme-modal-overlay';
        overlay.innerHTML = `
            <div class="pbx-meetme-modal">
                <h4>${this.t('pbx_meetme_edit', 'Termin bearbeiten')}</h4>
                <label>${this.t('pbx_meetme_field_title', 'Titel')}</label>
                <input id="pbx-mm-edit-title" type="text" value="${this._meetmeEsc(m.title)}">
                <label>${this.t('pbx_meetme_field_duration', 'Dauer (Minuten)')}</label>
                <input id="pbx-mm-edit-duration" type="number" value="${m.duration_minutes}">
                <label>${this.t('pbx_meetme_field_room', 'Konferenzraum')}</label>
                <select id="pbx-mm-edit-room">
                    <option value="">${this.t('pbx_meetme_room_none', '– kein fester Raum –')}</option>
                    ${rooms.map(r => `<option value="${r.room_extension}" ${r.room_extension === m.room_extension ? 'selected' : ''}>${r.room_extension}${r.hint_state ? ' (' + r.hint_state + ')' : ''}</option>`).join('')}
                </select>
                <label>${this.t('pbx_meetme_field_desc', 'Beschreibung')}</label>
                <textarea id="pbx-mm-edit-desc" rows="3">${this._meetmeEsc(m.description || '')}</textarea>
                <div class="pbx-meetme-modal-actions">
                    <button class="pbx-act pbx-act-gray" onclick="PBX.meetmeCloseModal()">${this.t('pbx_cancel', 'Abbrechen')}</button>
                    <button class="pbx-act pbx-act-green" onclick="PBX.meetmeSaveEdit(${meetingId})">${this.t('pbx_meetme_save', 'Speichern')}</button>
                </div>
            </div>
        `;
        document.body.appendChild(overlay);
    },

    async meetmeSaveEdit(meetingId) {
        const title = this.$('pbx-mm-edit-title').value.trim();
        const duration = parseInt(this.$('pbx-mm-edit-duration').value, 10) || 60;
        const room = this.$('pbx-mm-edit-room').value;
        const desc = this.$('pbx-mm-edit-desc').value;
        if (!title) { this.toast(this.t('pbx_meetme_fields_req', 'Titel erforderlich')); return; }

        try {
            await this.patchReq(`/meetme/api/meetings/${meetingId}/update/`, {
                title, duration_minutes: duration, room_extension: room, description: desc,
            });
            this.meetmeCloseModal();
            this.toast(this.t('pbx_meetme_saved', 'Gespeichert'));
            await this.meetmeLoadMeetings();
            this.meetmeSelectMeeting(meetingId);
        } catch (e) {
            this.toast(this.t('pbx_meetme_save_err', 'Speichern fehlgeschlagen'));
        }
    },

    meetmeShowCancelConfirm(meetingId) {
        const m = (this._meetmeState.meetings || []).find(x => x.id === meetingId);
        if (!m) return;
        const overlay = document.createElement('div');
        overlay.className = 'pbx-meetme-modal-overlay';
        overlay.id = 'pbx-meetme-modal-overlay';
        overlay.innerHTML = `
            <div class="pbx-meetme-modal" style="width:360px">
                <h4><i class="bi bi-exclamation-triangle-fill" style="color:#b02a37"></i> ${this.t('pbx_meetme_cancel_confirm_title', 'Termin absagen?')}</h4>
                <p style="font-size:13px;margin:10px 0">
                    ${this.t('pbx_meetme_cancel_confirm_text', 'Der Termin')} "${this._meetmeEsc(m.title)}" ${this.t('pbx_meetme_cancel_confirm_text2', 'wird auf \'Abgesagt\' gesetzt. Alle offenen, noch nicht gesendeten Erinnerungen werden storniert. Bereits gesendete Erinnerungen bleiben als Protokoll erhalten.')}
                </p>
                <div class="pbx-meetme-modal-actions">
                    <button class="pbx-act pbx-act-gray" onclick="PBX.meetmeCloseModal()">${this.t('pbx_cancel', 'Zurück')}</button>
                    <button class="pbx-act pbx-act-red" onclick="PBX.meetmeConfirmCancel(${meetingId})">${this.t('pbx_meetme_cancel_confirm_btn', 'Ja, absagen')}</button>
                </div>
            </div>
        `;
        document.body.appendChild(overlay);
    },

    async meetmeConfirmCancel(meetingId) {
        try {
            await this.del(`/meetme/api/meetings/${meetingId}/cancel/`);
            this.meetmeCloseModal();
            this.toast(this.t('pbx_meetme_cancelled', 'Termin abgesagt'));
            await this.meetmeLoadMeetings();
            this.meetmeSelectMeeting(meetingId);
        } catch (e) {
            this.toast(this.t('pbx_meetme_cancel_err', 'Absagen fehlgeschlagen'));
        }
    },

    async patchReq(url, body) {
        const r = await fetch(url, {
            method: 'PATCH',
            headers: { 'Content-Type': 'application/json', 'X-CSRFToken': this.csrf(), 'X-Requested-With': 'XMLHttpRequest' },
            body: JSON.stringify(body || {}),
        });
        return r.json();
    },
});
