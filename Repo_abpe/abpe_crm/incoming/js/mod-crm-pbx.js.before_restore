Object.assign(PBX.api, {
    meetmeDeliveryQueue: '/meetme/api/deliveries/queue/',
    emailTemplates: '/email-studio/api/templates/',
});

Object.assign(PBX, {
    _saState: { queue: [], idx: 0, templates: [] },

    async meetmeOpenSendAssistant(meetingId) {
        let data = null;
        try { data = await this.get(this.api.meetmeDeliveryQueue + '?meeting_id=' + meetingId); }
        catch (e) { this.toast(this.t('pbx_sa_load_err', 'Warteschlange konnte nicht geladen werden')); return; }

        const queue = data || [];
        if (!queue.length) {
            this.toast(this.t('pbx_sa_empty', 'Keine offenen Erinnerungen')); return;
        }

        let tplData = null;
        try { tplData = await this.get(this.api.emailTemplates); }
        catch (e) { /* Templates optional, Assistent funktioniert auch ohne */ }

        this._saState.queue = queue;
        this._saState.idx = 0;
        this._saState.templates = (tplData && tplData.templates) || [];
        this._saRender();
    },

    _saRender() {
        const st = this._saState;
        const d = st.queue[st.idx];
        if (!d) { this.meetmeCloseModal(); return; }

        let overlay = document.getElementById('pbx-meetme-modal-overlay');
        if (!overlay) {
            overlay = document.createElement('div');
            overlay.className = 'pbx-meetme-modal-overlay';
            overlay.id = 'pbx-meetme-modal-overlay';
            document.body.appendChild(overlay);
        }

        const chips = st.queue.map((item, i) => {
            let cls = 'pbx-sa-chip';
            if (i < st.idx) cls += ' done';
            if (i === st.idx) cls += ' current';
            return `<span class="${cls}">${this._meetmeEsc(item.guest_name || '')}</span>`;
        }).join('');

        const tplOptions = st.templates.map(t =>
            `<option value="${t.id}">${this._meetmeEsc(t.name)}</option>`
        ).join('');

        overlay.innerHTML = `
            <div class="pbx-meetme-modal pbx-sa-modal">
                <div style="display:flex;justify-content:space-between;align-items:center">
                    <h4 style="margin:0">${this.t('pbx_sa_title', 'Sende-Assistent')}</h4>
                    <button class="pbx-act pbx-act-gray" onclick="PBX.meetmeCloseModal()">
                        <i class="bi bi-x-lg"></i> ${this.t('pbx_cancel', 'Abbrechen')}
                    </button>
                </div>
                <div class="pbx-sa-guestchips">${chips}</div>
                <p class="pbx-sa-meta">${this.t('pbx_sa_of', 'Gast')} ${st.idx + 1} ${this.t('pbx_sa_of2', 'von')} ${st.queue.length} · ${this._meetmeEsc(d.guest_email || '')}</p>

                <label>${this.t('pbx_sa_template', 'Vorlage')}</label>
                <div style="display:flex;gap:6px">
                    <select id="pbx-sa-template" style="flex:1">
                        <option value="">${this.t('pbx_sa_template_none', '– keine –')}</option>
                        ${tplOptions}
                    </select>
                    <button class="pbx-act pbx-act-gray" onclick="PBX._saLoadTemplate()">${this.t('pbx_sa_load', 'Laden')}</button>
                </div>

                <div class="pbx-sa-mailbox">
                    <div class="pbx-sa-mailhead">
                        <div class="pbx-sa-avatar">${this._meetmeInitials(d.guest_name)}</div>
                        <div style="flex:1;min-width:0">
                            <p style="font-size:12.5px;font-weight:600;margin:0">${this._meetmeEsc(d.guest_name || '')} <span style="font-weight:400;color:#999">&lt;${this._meetmeEsc(d.guest_email || '')}&gt;</span></p>
                        </div>
                    </div>
                    <div class="pbx-sa-subject">
                        <input id="pbx-sa-subject" type="text" value="${this._meetmeEsc(d.subject || '')}" placeholder="${this.t('pbx_sa_subject_ph', 'Betreff')}">
                    </div>
                    <div class="pbx-sa-body">
                        <textarea id="pbx-sa-body" rows="6">${this._meetmeEsc(d.body || '')}</textarea>
                    </div>
                </div>

                <div class="pbx-sa-ds">
                    <div style="display:flex;justify-content:space-between;align-items:center">
                        <span style="font-size:12.5px;font-weight:600"><i class="bi bi-stars"></i> ${this.t('pbx_sa_deepseek', 'DeepSeek-Raupe')}</span>
                        <button class="pbx-act pbx-act-gray" onclick="PBX._saDeepseekSuggest()"><i class="bi bi-arrow-clockwise"></i> ${this.t('pbx_sa_suggest', 'Vorschlag generieren')}</button>
                    </div>
                    <label>${this.t('pbx_sa_your_text', 'Ihr Text (oben, wird gesendet)')}</label>
                    <textarea id="pbx-sa-ds-top" rows="3"></textarea>
                    <label>${this.t('pbx_sa_suggestion', 'DeepSeek-Vorschlag (zum Rüberkopieren)')}</label>
                    <textarea id="pbx-sa-ds-bottom" rows="3" readonly></textarea>
                </div>

                <div class="pbx-sa-footer">
                    <span class="pbx-sa-hint"><i class="bi bi-link-45deg"></i> ${this.t('pbx_sa_linked_hint', 'wird im E-Mail-Verlauf zugeordnet')}</span>
                    <div style="display:flex;gap:8px">
                        <button class="pbx-act pbx-act-gray" onclick="PBX._saSkip()">${this.t('pbx_sa_skip', 'Überspringen')}</button>
                        <button class="pbx-act pbx-act-green" onclick="PBX._saSendAndNext()">${this.t('pbx_sa_send_next', 'Senden & weiter')}</button>
                    </div>
                </div>
            </div>
        `;
    },

    _meetmeInitials(name) {
        return (name || '').split(' ').map(p => p[0] || '').join('').slice(0, 2).toUpperCase();
    },

    async _saLoadTemplate() {
        const tplId = this.$('pbx-sa-template').value;
        if (!tplId) return;
        try {
            const data = await this.get(this.api.emailTemplates + tplId + '/');
            const tpl = data && data.template;
            if (!tpl) return;
            this.$('pbx-sa-subject').value = tpl.subject || '';
            this.$('pbx-sa-body').value = tpl.text_body || tpl.html_body || '';
        } catch (e) {
            this.toast(this.t('pbx_sa_template_err', 'Vorlage konnte nicht geladen werden'));
        }
    },

    async _saDeepseekSuggest() {
        const current = this.$('pbx-sa-body').value.trim();
        if (!current) {
            this.toast(this.t('pbx_sa_ds_empty', 'Erst Text eingeben oder Vorlage laden'));
            return;
        }
        this.$('pbx-sa-ds-top').value = current;
        const btn = event.currentTarget;
        const origHtml = btn ? btn.innerHTML : '';
        if (btn) { btn.innerHTML = '<i class="bi bi-hourglass-split"></i> ...'; btn.disabled = true; }
        try {
            const res = await this.post('/meetme/api/deepseek-suggest/', { text: current });
            if (res && res.suggestion) {
                this.$('pbx-sa-ds-bottom').value = res.suggestion;
            } else {
                this.toast(this.t('pbx_sa_ds_err', 'DeepSeek konnte keinen Vorschlag liefern'));
            }
        } catch (e) {
            this.toast(this.t('pbx_sa_ds_err', 'DeepSeek konnte keinen Vorschlag liefern'));
        } finally {
            if (btn) { btn.innerHTML = origHtml; btn.disabled = false; }
        }
    },

    async _saSkip() {
        const st = this._saState;
        const d = st.queue[st.idx];
        try { await this.post(`/meetme/api/deliveries/${d.id}/skip/`, {}); }
        catch (e) { /* trotzdem weiter */ }
        st.idx += 1;
        this._saRender();
    },

    async _saSendAndNext() {
        const st = this._saState;
        const d = st.queue[st.idx];
        const subject = this.$('pbx-sa-subject').value;
        const body = this.$('pbx-sa-body').value;
        try {
            await this.post(`/meetme/api/deliveries/${d.id}/mark-sent/`, { subject, body });
            this.toast(this.t('pbx_sa_sent', 'Gesendet'));
        } catch (e) {
            this.toast(this.t('pbx_sa_send_err', 'Senden fehlgeschlagen'));
            return;
        }
        st.idx += 1;
        this._saRender();
    },
});


