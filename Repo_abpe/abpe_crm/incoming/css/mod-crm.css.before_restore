/* ============================================================
   ABpE CRM — mod-crm.css
   Gemeinsame Basis: Stats-Bar, Query-Help, List, Detail-Panel
   ============================================================ */

/* ── CRM Topbar ─────────────────────────────────────────── */
.crm-topbar {
    position: fixed;
    top: 0; left: 0; right: 0;
    height: 60px;
    background: var(--abcona-blue);
    display: flex;
    align-items: center;
    padding: 0 16px;
    gap: 12px;
    z-index: 999;
}

.crm-topbar .logo-area span {
    color: #fff;
    font-weight: 700;
    font-size: 15px;
}

.crm-search-wrap {
    flex: 1;
    display: flex;
    align-items: center;
    gap: 8px;
    max-width: 700px;
}

.crm-sort-select {
    background: rgba(255,255,255,.15);
    border: 1px solid rgba(255,255,255,.2);
    border-radius: 8px;
    color: #fff;
    padding: 6px 10px;
    font-size: 12px;
    cursor: pointer;
}

.crm-sort-select option { background: var(--abcona-blue); }

.crm-search-btn {
    background: #2563eb;
    color: #fff;
    border: none;
    border-radius: 8px;
    padding: 7px 16px;
    font-size: 12px;
    font-weight: 600;
    cursor: pointer;
    white-space: nowrap;
    display: flex;
    align-items: center;
    gap: 5px;
}

.crm-search-btn:hover { background: #1d4ed8; }

.crm-help-btn {
    background: rgba(255,255,255,.15);
    color: #fff;
    border: 1px solid rgba(255,255,255,.2);
    border-radius: 8px;
    padding: 6px 12px;
    font-size: 12px;
    cursor: pointer;
    white-space: nowrap;
}

.crm-help-btn:hover { background: rgba(255,255,255,.25); }

/* ── Query Help ─────────────────────────────────────────── */
.crm-query-help {
    background: #fff;
    border-bottom: 1px solid var(--border-color);
    padding: 10px 16px;
    margin-left: 52px;
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    position: fixed;
    top: 60px;
    left: 0; right: 0;
    z-index: 998;
    box-shadow: 0 2px 8px rgba(0,0,0,.08);
}

.qh-section {
    display: flex;
    align-items: center;
    gap: 4px;
    flex-wrap: wrap;
}

.qh-label {
    font-size: 11px;
    color: var(--text-muted);
    font-weight: 600;
    margin-right: 2px;
}

.qh-tag {
    font-size: 11px;
    background: var(--abcona-gray-card);
    color: var(--abcona-blue);
    padding: 2px 7px;
    border-radius: 4px;
    border: 1px solid var(--border-color);
    cursor: pointer;
    font-family: monospace;
}

.qh-tag:hover { background: var(--abcona-blue); color: #fff; }

.qh-text { font-size: 11px; color: var(--text-secondary); margin-right: 4px; }

.qh-example {
    font-size: 11px;
    background: var(--abcona-blue);
    color: #fff;
    padding: 2px 8px;
    border-radius: 4px;
    cursor: pointer;
}

.qh-example:hover { background: var(--abcona-blue-light); }

/* ── Sidebar Navigation ─────────────────────────────────── */
.crm-sidebar-nav {
    position: fixed;
    left: 0; top: 60px; bottom: 0;
    width: 52px;
    background: var(--abcona-blue);
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 8px 0;
    gap: 4px;
    z-index: 100;
}

.crm-nav-item {
    width: 36px;
    height: 36px;
    border-radius: 8px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: rgba(255,255,255,.55);
    text-decoration: none;
    font-size: 18px;
    transition: all .2s;
}

.crm-nav-item:hover { background: var(--abcona-blue-light); color: #fff; }
.crm-nav-item.active { background: var(--abcona-blue-dark); color: #fff; }

/* ── Main Content ───────────────────────────────────────── */
.crm-main {
    margin-left: 52px;
    padding: 74px 16px 16px 16px;
    min-height: 100vh;
    background: var(--abcona-gray-bg);
}

/* ── Stats Bar ──────────────────────────────────────────── */
.crm-stats-bar {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 10px;
    margin-bottom: 14px;
}

.crm-stat {
    background: var(--abcona-gray-card);
    border-radius: var(--border-radius-card);
    padding: 10px;
    text-align: center;
    border: 1px solid var(--border-color);
    transition: all .2s;
}

.crm-stat:hover { transform: translateY(-2px); }

.crm-stat-val {
    display: block;
    font-size: 22px;
    font-weight: 700;
    color: var(--abcona-blue);
    line-height: 1.2;
}

.crm-stat-lbl {
    font-size: 10px;
    color: var(--text-muted);
    margin-top: 2px;
    display: block;
}

/* ── Two Column Layout ──────────────────────────────────── */
.crm-two-col {
    display: grid;
    grid-template-columns: 1fr 400px;
    gap: 12px;
    align-items: flex-start;
}

.crm-full-panel {
    background: #fff;
    border-radius: var(--border-radius-card);
    border: 1px solid var(--border-color);
    overflow: hidden;
}

/* ── List Panel ─────────────────────────────────────────── */
.crm-list-panel {
    background: #fff;
    border-radius: var(--border-radius-card);
    overflow: hidden;
    border: 1px solid var(--border-color);
}

.crm-new-btn {
    margin-left: auto;
    background: rgba(255,255,255,.15);
    color: #fff;
    border: 1px solid rgba(255,255,255,.3);
    border-radius: 8px;
    padding: 4px 10px;
    font-size: 11px;
    font-weight: 600;
    cursor: pointer;
    display: flex;
    align-items: center;
    gap: 4px;
}

.crm-new-btn:hover { background: rgba(255,255,255,.25); }

.crm-filter-bar {
    display: flex;
    gap: 8px;
    padding: 8px 12px;
    border-bottom: 1px solid var(--border-light);
    background: var(--abcona-gray-card);
}

.crm-filter-bar select {
    padding: 5px 8px;
    border: 1px solid var(--border-color);
    border-radius: 7px;
    font-size: 12px;
    background: #fff;
}

/* ── List Items ─────────────────────────────────────────── */
.crm-list { min-height: 200px; }

.crm-list-loading {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 40px;
    color: var(--text-muted);
    font-size: 13px;
}

.crm-list-item {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 9px 12px;
    border-bottom: 1px solid var(--border-light);
    cursor: pointer;
    transition: background .15s;
}

.crm-list-item:hover { background: var(--abcona-gray-card); }
.crm-list-item.active { background: var(--abcona-gray-bg); border-left: 3px solid var(--abcona-blue); }

.crm-avatar {
    width: 34px;
    height: 34px;
    border-radius: 50%;
    background: var(--abcona-blue);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 12px;
    font-weight: 600;
    color: #fff;
    flex-shrink: 0;
}

.crm-avatar-sq { border-radius: 8px; }

.crm-item-info { flex: 1; min-width: 0; }

.crm-item-name {
    font-size: 13px;
    font-weight: 600;
    color: var(--abcona-blue);
}

.crm-item-sub {
    font-size: 11px;
    color: var(--text-muted);
    margin-top: 1px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.crm-item-tags { display: flex; gap: 3px; margin-top: 4px; flex-wrap: wrap; }

.crm-tag {
    font-size: 10px;
    background: var(--abcona-gray-bg);
    color: var(--text-secondary);
    padding: 1px 6px;
    border-radius: 20px;
    border: 1px solid var(--border-color);
}

.crm-item-right {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 3px;
    flex-shrink: 0;
}

/* ── Badges ─────────────────────────────────────────────── */
.crm-badge {
    font-size: 10px;
    padding: 2px 7px;
    border-radius: 20px;
    font-weight: 600;
}

.crm-badge-aktiv   { background: var(--badge-success-bg);  color: var(--badge-success-text); }
.crm-badge-passiv  { background: var(--abcona-gray-card);  color: var(--text-muted); border: 1px solid var(--border-color); }
.crm-badge-warning { background: var(--badge-warning-bg);  color: var(--badge-warning-text); }
.crm-badge-error   { background: var(--badge-error-bg);    color: var(--badge-error-text); }

/* ── Detail Panel ───────────────────────────────────────── */
.crm-detail-panel {
    background: #fff;
    border-radius: var(--border-radius-card);
    border: 1px solid var(--border-color);
    overflow: hidden;
    position: sticky;
    top: 74px;
    max-height: calc(100vh - 90px);
    overflow-y: auto;
}

.crm-detail-empty {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 60px 20px;
    color: var(--text-muted);
    font-size: 13px;
    gap: 10px;
}

.crm-detail-empty i { font-size: 40px; opacity: .3; }

.crm-detail-head {
    background: var(--abcona-blue);
    color: #fff;
    padding: 12px 14px 10px;
}

.crm-detail-avatar-row {
    display: flex;
    align-items: center;
    gap: 10px;
}

.crm-detail-name { font-size: 14px; font-weight: 700; color: #fff; }
.crm-detail-sub  { font-size: 11px; color: rgba(255,255,255,.65); margin-top: 1px; }

.crm-detail-tags { display: flex; gap: 4px; margin-top: 8px; flex-wrap: wrap; }

.crm-detail-tag {
    font-size: 10px;
    background: rgba(255,255,255,.15);
    color: rgba(255,255,255,.9);
    padding: 2px 7px;
    border-radius: 20px;
}

.crm-detail-actions {
    display: flex;
    gap: 6px;
    margin-top: 9px;
}

.crm-action-btn {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 4px;
    padding: 6px 0;
    font-size: 11px;
    font-weight: 600;
    border-radius: 7px;
    border: none;
    cursor: pointer;
    text-decoration: none;
}

.crm-action-btn-primary { background: var(--status-green); color: #fff; }
.crm-action-btn-secondary { background: rgba(255,255,255,.15); color: #fff; border: 1px solid rgba(255,255,255,.3); }
.crm-action-btn-secondary:hover { background: rgba(255,255,255,.25); }

/* ── Detail Tabs ─────────────────────────────────────────── */
.crm-detail-tabs {
    display: flex;
    border-bottom: 2px solid var(--border-color);
    padding: 0 12px;
    background: var(--abcona-gray-card);
}

.crm-detail-tab {
    padding: 8px 10px;
    font-size: 11px;
    font-weight: 600;
    color: var(--text-muted);
    border-bottom: 2px solid transparent;
    margin-bottom: -2px;
    cursor: pointer;
    white-space: nowrap;
    transition: color .15s;
}

.crm-detail-tab:hover { color: var(--abcona-blue-light); }
.crm-detail-tab.active { color: var(--abcona-blue); border-bottom-color: var(--abcona-blue); }

/* ── Detail Body ─────────────────────────────────────────── */
.crm-detail-body { padding: 12px; }

.crm-info-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 6px;
    margin-bottom: 12px;
}

.crm-info-box {
    background: var(--abcona-gray-bg);
    border-radius: 7px;
    padding: 7px 8px;
    border: 1px solid var(--border-color);
}

.crm-info-box-full { grid-column: 1 / -1; }

.crm-info-label { font-size: 10px; color: var(--text-muted); }
.crm-info-value { font-size: 12px; font-weight: 700; color: var(--abcona-blue); margin-top: 1px; }

.crm-section { margin-bottom: 12px; }

.crm-section-label {
    font-size: 10px;
    font-weight: 700;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: .05em;
    margin-bottom: 6px;
}

.crm-info-row {
    display: flex;
    align-items: center;
    gap: 7px;
    font-size: 11px;
    color: var(--text-primary);
    padding: 4px 0;
    border-bottom: 1px solid var(--border-light);
}

.crm-info-row:last-child { border-bottom: none; }
.crm-info-row i { font-size: 13px; color: var(--abcona-blue); width: 15px; }
.crm-info-row-val { margin-left: auto; color: var(--text-muted); font-size: 10px; }

/* ── History Items ───────────────────────────────────────── */
.crm-hist-item {
    display: flex;
    align-items: center;
    gap: 7px;
    padding: 5px 0;
    border-bottom: 1px solid var(--border-light);
    font-size: 11px;
}

.crm-hist-item:last-child { border-bottom: none; }
.crm-hist-right { margin-left: auto; font-size: 10px; color: var(--text-muted); }

/* ── Note Area ───────────────────────────────────────────── */
.crm-note-area {
    width: 100%;
    padding: 7px;
    font-size: 12px;
    border: 1px solid var(--border-color);
    border-radius: 7px;
    background: var(--abcona-gray-card);
    color: var(--text-primary);
    resize: none;
    height: 65px;
    font-family: Arial, sans-serif;
}

.crm-save-btn {
    margin-top: 6px;
    width: 100%;
    padding: 7px;
    font-size: 12px;
    font-weight: 600;
    border-radius: 7px;
    border: none;
    background: var(--abcona-blue);
    color: #fff;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 4px;
}

.crm-save-btn:hover { background: var(--abcona-blue-light); }

/* ── Pagination ──────────────────────────────────────────── */
.crm-pagination {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    padding: 10px;
    border-top: 1px solid var(--border-light);
}

.crm-page-btn {
    padding: 4px 10px;
    font-size: 12px;
    border: 1px solid var(--border-color);
    border-radius: 6px;
    background: #fff;
    cursor: pointer;
    color: var(--abcona-blue);
}

.crm-page-btn.active { background: var(--abcona-blue); color: #fff; border-color: var(--abcona-blue); }
.crm-page-btn:hover:not(.active) { background: var(--abcona-gray-bg); }

/* ── Responsive ──────────────────────────────────────────── */
@media (max-width: 992px) {
    .crm-two-col { grid-template-columns: 1fr; }
    .crm-detail-panel { position: static; max-height: none; }
    .crm-stats-bar { grid-template-columns: repeat(2, 1fr); }
}

@media (max-width: 768px) {
    .crm-stats-bar { grid-template-columns: 1fr; }
    .crm-search-wrap { max-width: 100%; }
}

/* ── View Toggle Liste/Zuletzt ───────────────────────── */
.crm-view-toggle {
    display: flex;
    align-items: center;
    border: 1px solid var(--border-color, #dee2e6);
    border-radius: 6px;
    overflow: hidden;
    margin-left: auto;
}
.crm-toggle-btn {
    padding: 4px 12px;
    font-size: 13px;
    background: var(--bg-color, #fff);
    color: var(--text-muted, #6c757d);
    border: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    gap: 5px;
    white-space: nowrap;
}
.crm-toggle-btn + .crm-toggle-btn {
    border-left: 1px solid var(--border-color, #dee2e6);
}
.crm-toggle-btn.active {
    background: var(--abcona-dark, #1a2744);
    color: #fff;
}
.crm-toggle-btn.active select,
.crm-toggle-btn.active select option {
    background: var(--abcona-dark, #1a2744);
    color: #fff;
}
.crm-toggle-btn:not(.active) select,
.crm-toggle-btn:not(.active) select option {
    background: #fff;
    color: #1a2744;
}
